# Server listening port (Railway and Render inject PORT automatically)
PORT=3000

# Runtime environment ("development" or "production")
NODE_ENV=development

# Public site URL used for canonical sitemap generation (optional)
APP_URL=https://your-domain.example.com

# PostgreSQL connection string (recommended for Railway / Render / Supabase production)
# Leave empty to use local JSON persistence in DATA_DIR
DATABASE_URL=

# Set to "true" if your managed PostgreSQL requires SSL with self-signed certs
# (Automatically enabled for non-localhost DATABASE_URL; set "false" to disable)
DATABASE_SSL=

# Local / persistent volume storage directory for JSON store & uploaded images
# Mount a persistent disk on Railway/Render (e.g. /data) and set DATA_DIR=/data
DATA_DIR=

# Admin dashboard passcode (optional)
# Leave unset on first run to claim an admin password securely in /admin UI,
# or set a strong passcode in environment secrets before deploying.
ADMIN_PASSCODE=

# Secret key for signing admin session tokens (minimum 16 characters recommended)
SESSION_SECRET=
